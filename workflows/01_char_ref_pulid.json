{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux1-dev.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {"title": "Load FLUX.1-dev"}
  },
  "2": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "t5xxl_fp16.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    },
    "_meta": {"title": "Load CLIP (t5 + clip_l)"}
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {"vae_name": "ae.safetensors"},
    "_meta": {"title": "Load VAE"}
  },
  "4": {
    "class_type": "PulidFluxModelLoader",
    "inputs": {"pulid_file": "pulid_flux_v0.9.1.safetensors"},
    "_meta": {"title": "PuLID-Flux Loader"}
  },
  "5": {
    "class_type": "PulidFluxInsightFaceLoader",
    "inputs": {"provider": "CUDA"},
    "_meta": {"title": "InsightFace Loader"}
  },
  "6": {
    "class_type": "PulidFluxEvaClipLoader",
    "inputs": {},
    "_meta": {"title": "EVA-CLIP Loader"}
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": {"image": "PLACEHOLDER_FACE_REF.png"},
    "_meta": {"title": "Load Face Reference"}
  },
  "15": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "character reference sheet, manga style, detailed linework, 8k",
      "clip": ["2", 0]
    },
    "_meta": {"title": "Positive Prompt"}
  },
  "16": {
    "class_type": "CLIPTextEncode",
    "inputs": {"text": "", "clip": ["2", 0]},
    "_meta": {"title": "Negative Prompt (FLUX ignores)"}
  },
  "17": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {"width": 1024, "height": 1536, "batch_size": 1},
    "_meta": {"title": "Empty Latent"}
  },
  "20": {
    "class_type": "ApplyPulidFlux",
    "inputs": {
      "model": ["1", 0],
      "pulid_flux": ["4", 0],
      "eva_clip": ["6", 0],
      "face_analysis": ["5", 0],
      "image": ["10", 0],
      "weight": 0.95,
      "start_at": 0.0,
      "end_at": 1.0,
      "attn_mask": null
    },
    "_meta": {"title": "Apply PuLID (face lock)"}
  },
  "18": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["20", 0],
      "positive": ["15", 0],
      "negative": ["16", 0],
      "latent_image": ["17", 0],
      "seed": 42,
      "steps": 28,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    },
    "_meta": {"title": "KSampler"}
  },
  "21": {
    "class_type": "VAEDecode",
    "inputs": {"samples": ["18", 0], "vae": ["3", 0]},
    "_meta": {"title": "VAE Decode"}
  },
  "22": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["21", 0],
      "filename_prefix": "char_ref"
    },
    "_meta": {"title": "Save"}
  }
}
